{
  "name": "carousel-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "node --import tsx --import ./test/env.ts --test \"test/**/*.test.ts\"",
    "check-gimp": "tsx --env-file=.env src/check_gimp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
