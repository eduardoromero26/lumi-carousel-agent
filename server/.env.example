# Meta Model API (OpenAI-compatible): https://dev.meta.ai/docs/quickstart
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# Vision + tool calling model used by every agent
MODEL_ID=muse-spark-1.3
# The art director (one call per carousel): the visual system and its decor kit.
# Falls back to MODEL_ID when it fails.
ART_MODEL_ID=muse-wonder-1.0
# The decor kit (texture and recurring element) and the designer's decorative assets
IMAGE_MODEL_ID=muse-image-1.0
# Finds the subject of each photo so crops and text never cover it
SAM_MODEL_ID=sam-3.1
# HyperFrames CLI used for the animated cards (npx, needs ffmpeg)
HYPERFRAMES_VERSION=0.8.210

# GIMP MCP server (https://github.com/maorcc/gimp-mcp): the plugin must be
# installed in GIMP 3.2.
GIMP_MCP_PYTHON=C:/path/to/gimp-mcp/.venv/Scripts/python.exe
GIMP_MCP_SERVER=C:/path/to/gimp-mcp/gimp_mcp_server.py

# gimp-console executable: the server starts GIMP headless (no window) with the
# MCP plugin. Leave empty to use a GIMP you opened yourself (Tools > MCP >
# Start MCP Server), handy to watch the agents work in the GIMP window.
GIMP_CONSOLE=C:/path/to/GIMP 3/bin/gimp-console-3.2.exe

PORT=8787
# Max critic rounds per slide before accepting the best attempt
MAX_REVISIONS=1
# Max GIMP tool calls the designer can make per round
MAX_DESIGN_STEPS=20
# 1 turns the 30 s reel back on (off: it takes as long as a whole carousel)
REELS=0
# A rejected reel is rendered again only below this critic score (0-10)
REEL_RETRY_BELOW=5
